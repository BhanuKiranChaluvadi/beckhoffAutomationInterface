<!--
  Test fixture for TwinCAT Variant Management.
  Two machines; each group name becomes a PLC compiler define, so it works as a
  feature switch: MAIN tests {IF defined (PCV_MODBUS)}, never a machine name.
  Port of BeckhoffLib/Experiments/VariantDemo (verified on UmRT 2026-10-14).
-->
<Variants DefineMode="Implicit">
  <Variant Name="MachineA" />
  <Variant Name="MachineB" />
  <Group Name="PCV_MODBUS">
    <Member>MachineA</Member>
  </Group>
  <Group Name="PCV_ETHERCAT">
    <Member>MachineB</Member>
  </Group>
</Variants>
