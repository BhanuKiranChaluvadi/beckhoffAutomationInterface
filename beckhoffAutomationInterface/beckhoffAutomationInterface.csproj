<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Keep equal to the release tag: bai prints it with the commit as its version. -->
    <Version>1.10.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Interop.TCatSysManager">
      <HintPath>Interop.TCatSysManager.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
    <!-- JavaScriptSerializer for expect.json (part of .NET Framework 4.8, no NuGet) -->
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runs as root on a TwinCAT/BSD host; package install with ssh copies it there. -->
    <EmbeddedResource Include="Release\bsd_boot_transaction.py" LogicalName="bsd_boot_transaction.py" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EnvDTE" Version="8.0.2" />
    <PackageReference Include="EnvDTE80" Version="8.0.2" />
  </ItemGroup>

</Project>
